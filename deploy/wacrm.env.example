# Copy to /docker/wacrm/.env on the VPS and fill. chmod 600 .env
# NEVER commit the filled file.

# Public hostname served by Traefik (DNS A record -> 76.13.14.45)
WACRM_HOST=crm.dachprotect.com.pl

# --- Hosted Supabase project (EU region!) — Project Settings -> API ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App secrets (generate fresh for prod; do NOT reuse spike values) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# openssl rand -hex 32
AUTOMATION_CRON_SECRET=

# --- Meta (G3; leave placeholders until the Meta app exists) ---
META_APP_SECRET=
META_APP_ID=

# --- Kanoniczna lista wykluczen lejka reaktywacyjnego AMP -------------------
# INNY projekt Supabase niz NEXT_PUBLIC_SUPABASE_URL powyzej: tabela
# suppression_list zyje w bazie kalkulatora (razem z reactivation_leads), bo
# § 8 ust. 3 umowy powierzenia wymaga zaprzestania komunikacji WE WSZYSTKICH
# kanalach. Sprzeciw z WhatsAppa musi blokowac takze SMS i Meta Custom Audience,
# wiec lista moze byc tylko jedna.
#
# Bez tych zmiennych recordOptOut rzuca, webhook loguje
# [suppression][DO-REKONCYLIACJI] i ustawia contacts.opted_out jako bezpiecznik
# lokalny (migracja 037). Sprzeciw nie ginie, ale wymaga recznego dopisania.
SUPPRESSION_INGEST_URL=
SUPPRESSION_INGEST_SECRET=
